# Copy to .env.local for local development. Never commit real secret values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=https://www.as-sabiqun.com

HITPAY_ENV=sandbox
HITPAY_API_KEY=
HITPAY_WEBHOOK_SALT=

# Airwallex Hosted Payment Page. Leave PAYMENT_PROVIDER=hitpay until the
# Airwallex account, payment methods and webhook subscription are ready.
PAYMENT_PROVIDER=hitpay
AIRWALLEX_ENV=sandbox
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_WEBHOOK_SECRET=
AIRWALLEX_ACCOUNT_ID=

RESEND_API_KEY=

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=As-Sabiqun
BREVO_WEBHOOK_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Must match the Vault entry named as_sabiqun_internal_cron_secret in production.
INTERNAL_CRON_SECRET=
